From 1405fd0b14300c0958d66d3e7167a8e548b43ab1 Mon Sep 17 00:00:00 2001
From: vladiksicily1 <vlad.balesnyi@icloud.com>
Date: Sat, 5 Sep 2026 19:44:46 +0000
Subject: [PATCH] feat(mouse): implement PS/2 mouse IRQ12 driver and
 SYS_VLADOS_MOUSE (0x564D) syscall

---
 src/arch/x86_shared/device/mod.rs    |   1 +
 src/arch/x86_shared/interrupt/irq.rs | 115 +++++++++++++++++++++++++++
 src/syscall/mod.rs                   |  17 ++++
 3 files changed, 133 insertions(+)

diff --git a/src/arch/x86_shared/device/mod.rs b/src/arch/x86_shared/device/mod.rs
index d04d873..7a37bd3 100644
--- a/src/arch/x86_shared/device/mod.rs
+++ b/src/arch/x86_shared/device/mod.rs
@@ -17,6 +17,7 @@ pub mod tsc;
 pub unsafe fn init() {
     unsafe {
         pic::init();
+        crate::arch::interrupt::irq::init_ps2_mouse();
         local_apic::init(&mut KernelMapper::lock_rw());
 
         // Run here for the side effect of printing if KVM was used to avoid interleaved logs.
diff --git a/src/arch/x86_shared/interrupt/irq.rs b/src/arch/x86_shared/interrupt/irq.rs
index 1e826c0..00ceae2 100644
--- a/src/arch/x86_shared/interrupt/irq.rs
+++ b/src/arch/x86_shared/interrupt/irq.rs
@@ -14,6 +14,7 @@ use crate::{
     percpu::PercpuBlock,
     scheme::{irq::irq_trigger, serio::serio_input},
     sync::CleanLockToken,
+    syscall::io::{Io, Pio},
     time,
 };
 
@@ -347,6 +348,84 @@ interrupt!(pci3, || {
     }
 });
 
+#[repr(C)]
+#[derive(Clone, Copy, Debug)]
+pub struct MouseData {
+    pub x: i32,
+    pub y: i32,
+    pub buttons: u32,
+    pub seq: u32,
+}
+
+pub static MOUSE_DATA: spin::Mutex<MouseData> = spin::Mutex::new(MouseData {
+    x: 400,
+    y: 240,
+    buttons: 0,
+    seq: 1,
+});
+
+static MOUSE_PACKET: spin::Mutex<([u8; 3], usize)> = spin::Mutex::new(([0; 3], 0));
+
+pub unsafe fn init_ps2_mouse() {
+    let mut p64 = Pio::<u8>::new(0x64);
+    let mut p60 = Pio::<u8>::new(0x60);
+
+    for _ in 0..10000 {
+        if (p64.read() & 0x02) == 0 {
+            break;
+        }
+    }
+    p64.write(0xA8); // Enable auxiliary device (mouse)
+
+    p64.write(0x20); // Read config byte
+    for _ in 0..10000 {
+        if (p64.read() & 0x01) != 0 {
+            break;
+        }
+    }
+    let mut config = p60.read();
+    config |= 0x02;     // Enable mouse IRQ12
+    config &= !(1 << 5); // Enable mouse clock
+
+    p64.write(0x60); // Write config byte
+    for _ in 0..10000 {
+        if (p64.read() & 0x02) == 0 {
+            break;
+        }
+    }
+    p60.write(config);
+
+    // Set defaults (0xF6)
+    p64.write(0xD4);
+    for _ in 0..10000 {
+        if (p64.read() & 0x02) == 0 {
+            break;
+        }
+    }
+    p60.write(0xF6);
+    for _ in 0..10000 {
+        if (p64.read() & 0x01) != 0 {
+            let _ = p60.read();
+            break;
+        }
+    }
+
+    // Enable data streaming (0xF4)
+    p64.write(0xD4);
+    for _ in 0..10000 {
+        if (p64.read() & 0x02) == 0 {
+            break;
+        }
+    }
+    p60.write(0xF4);
+    for _ in 0..10000 {
+        if (p64.read() & 0x01) != 0 {
+            let _ = p60.read();
+            break;
+        }
+    }
+}
+
 interrupt!(mouse, || {
     let data: u8;
     unsafe { core::arch::asm!("in al, 0x60", out("al") data) };
@@ -355,6 +434,42 @@ interrupt!(mouse, || {
 
     let mut token = unsafe { CleanLockToken::new() };
     serio_input(1, data, &mut token);
+
+    let mut packet = MOUSE_PACKET.lock();
+    if packet.1 == 0 {
+        if (data & 0x08) != 0 {
+            packet.0[0] = data;
+            packet.1 = 1;
+        }
+    } else if packet.1 == 1 {
+        packet.0[1] = data;
+        packet.1 = 2;
+    } else if packet.1 == 2 {
+        packet.0[2] = data;
+        packet.1 = 0;
+
+        let flags = packet.0[0];
+        let raw_x = packet.0[1];
+        let raw_y = packet.0[2];
+
+        let dx = if (flags & 0x10) != 0 {
+            (raw_x as i16) - 256
+        } else {
+            raw_x as i16
+        } as i32;
+
+        let dy = if (flags & 0x20) != 0 {
+            (raw_y as i16) - 256
+        } else {
+            raw_y as i16
+        } as i32;
+
+        let mut mouse = MOUSE_DATA.lock();
+        mouse.x = (mouse.x + dx).clamp(0, 1279);
+        mouse.y = (mouse.y - dy).clamp(0, 799);
+        mouse.buttons = (flags & 0x07) as u32;
+        mouse.seq = mouse.seq.wrapping_add(1);
+    }
 });
 
 interrupt!(fpu, || {
diff --git a/src/syscall/mod.rs b/src/syscall/mod.rs
index 9502a49..3c80223 100644
--- a/src/syscall/mod.rs
+++ b/src/syscall/mod.rs
@@ -230,6 +230,23 @@ pub fn syscall(
 
             SYS_MPROTECT => mprotect(b, c, MapFlags::from_bits_truncate(d), token).map(|()| 0),
             SYS_MREMAP => mremap(b, c, d, e, f, token),
+            0x564D => {
+                #[cfg(target_arch = "x86_64")]
+                {
+                    use crate::arch::interrupt::irq::MOUSE_DATA;
+                    let mouse = *MOUSE_DATA.lock();
+                    let bytes = unsafe {
+                        core::slice::from_raw_parts(
+                            &mouse as *const _ as *const u8,
+                            core::mem::size_of_val(&mouse),
+                        )
+                    };
+                    UserSlice::wo(b, bytes.len())?.copy_exactly(bytes)?;
+                    Ok(mouse.seq as usize)
+                }
+                #[cfg(not(target_arch = "x86_64"))]
+                Err(Error::new(ENOSYS))
+            }
             _ => Err(Error::new(ENOSYS)),
         }
     }
-- 
