From 75c619b4cad138ecc2246d9c0435a8c3839b1b9a Mon Sep 17 00:00:00 2001
From: vladiksicily1 <vlad.balesnyi@icloud.com>
Date: Sat, 5 Sep 2026 19:31:17 +0000
Subject: [PATCH] feat(kernel): map linear GOP framebuffer into userspace at
 0x80000000 for GUI compositor

---
 src/syscall/process.rs | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/syscall/process.rs b/src/syscall/process.rs
index f8e3cad..5793d8e 100644
--- a/src/syscall/process.rs
+++ b/src/syscall/process.rs
@@ -144,7 +144,26 @@ pub unsafe fn usermode_bootstrap(bootstrap: &Bootstrap, token: &mut CleanLockTok
                         )?)
                     },
                 )
-                .expect("Failed to allocate bootstrap pages")
+                .expect("Failed to allocate bootstrap pages");
+
+            // Map GOP linear framebuffer into userspace at 0x8000_0000 for explorer.vex GUI
+            {
+                use crate::devices::graphical_debug::FRAMEBUFFER;
+                use rmm::{PhysicalAddress, VirtualAddress, PageFlags};
+                let (fb_phys, _fb_virt, fb_size) = *FRAMEBUFFER.lock();
+                if fb_phys != 0 && fb_size > 0 {
+                    let fb_user_base = 0x8000_0000usize;
+                    let pages = fb_size.div_ceil(PAGE_SIZE);
+                    let flags = PageFlags::new().user(true).write(true).write_combining(true);
+                    for i in 0..pages {
+                        let phys = PhysicalAddress::new(fb_phys + i * PAGE_SIZE);
+                        let virt = VirtualAddress::new(fb_user_base + i * PAGE_SIZE);
+                        if let Some(flush) = unsafe { addr_space_lock.table.utable.map_phys(virt, phys, flags) } {
+                            flush.ignore();
+                        }
+                    }
+                }
+            }
         };
 
         // Insert kernel schemes root capabilities.
