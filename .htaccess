# VladAero Apache Web Server Configuration
# Clean URLs, Security Headers, Gzip Compression & Caching

Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to hidden files and directories (starting with a dot, except .well-known)
    RewriteRule "(^|/)\.(?!well-known)" - [F]

    # Block direct access to config.php, schema.sql, seed_data.sql, logs
    RewriteRule ^(config\.php|schema\.sql|seed_data\.sql|\.installed_lock|error\.log)$ - [F,L]

    # Clean URL routing for Aircraft (/aircraft/boeing-777-300er)
    RewriteRule ^aircraft/([a-zA-Z0-9_-]+)/?$ aircraft.php?slug=$1 [L,QSA]
    RewriteRule ^aircraft/?$ aircraft.php [L,QSA]

    # Clean URL routing for Airports (/airport/uuee or /airport/uuee-sheremetyevo)
    RewriteRule ^airport/([a-zA-Z0-9_-]+)/?$ airports.php?code=$1 [L,QSA]
    RewriteRule ^airports/?$ airports.php [L,QSA]

    # Clean URL routing for Airlines (/airline/aeroflot)
    RewriteRule ^airline/([a-zA-Z0-9_-]+)/?$ airlines.php?slug=$1 [L,QSA]
    RewriteRule ^airlines/?$ airlines.php [L,QSA]

    # Clean URL routing for Articles (/articles/future-of-civil-aviation)
    RewriteRule ^articles/([a-zA-Z0-9_-]+)/?$ articles.php?slug=$1 [L,QSA]
    RewriteRule ^articles/?$ articles.php [L,QSA]

    # Clean URL routing for Quizzes (/quizzes/ppl-aerodynamics)
    RewriteRule ^quizzes/([a-zA-Z0-9_-]+)/?$ quizzes.php?slug=$1 [L,QSA]
    RewriteRule ^quizzes/?$ quizzes.php [L,QSA]

    # Clean URL routing for Incidents (/incidents/gimli-glider)
    RewriteRule ^incidents/([a-zA-Z0-9_-]+)/?$ incidents.php?slug=$1 [L,QSA]
    RewriteRule ^incidents/?$ incidents.php [L,QSA]

    # Standard clean URLs for static pages
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# MIME types
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest .json
    AddType image/webp .webp
    AddType model/gltf-binary .glb
    AddType model/gltf+json .gltf
    AddType audio/mpeg .mp3
    AddType audio/wav .wav
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType model/gltf-binary "access plus 1 month"
    ExpiresByType audio/mpeg "access plus 1 month"
</IfModule>

ErrorDocument 404 /404.php
