# VladAero Apache Shared Hosting Configuration
Options -Indexes
ServerSignature Off

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct access to sensitive core directories and logs
    RewriteRule ^(includes|cache|logs|backups)/ - [F,L,NC]
    RewriteRule ^(config\.php|schema\.sql|seed_data\.sql) - [F,L,NC]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compression for static assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
